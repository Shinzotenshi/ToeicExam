@using Abp.Authorization.Users
@model ToeicExam.Web.Models.Account.LoginFormViewModel
@{
    ViewBag.Title = "Đăng Nhập";
}
@section scripts
{
    <environment names="Development">
        <script src="~/view-resources/Views/Account/Login.js" asp-append-version="true"></script>
    </environment>

    <environment names="Staging,Production">
        <script src="~/view-resources/Views/Account/Login.min.js" asp-append-version="true"></script>
    </environment>
}

<div class="text-center mb-3">
    <div style="width: 56px; height: 56px; background: #eff6ff; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 12px; border: 1px solid #bfdbfe;">
        <i class="fas fa-user-shield text-primary" style="font-size: 24px;"></i>
    </div>
    <h4 class="font-weight-bold text-dark mb-1">Đăng Nhập Hệ Thống</h4>
    <p class="text-muted small mb-0">Dành cho Giảng viên & Cán bộ khảo thí</p>
</div>

<form id="LoginForm" asp-action="Login" method="post" class="mt-4">
    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
    <input type="hidden" name="returnUrlHash" />

    <div class="form-group mb-3">
        <label class="small font-weight-bold text-secondary mb-1">Tài khoản / Email:</label>
        <div class="input-group">
            <input type="text" name="usernameOrEmailAddress" class="form-control form-control-login" placeholder="admin hoặc email..." value="admin" required autofocus maxlength="@AbpUserBase.MaxEmailAddressLength">
            <div class="input-group-append">
                <span class="input-group-text input-group-text-login">
                    <i class="fas fa-user"></i>
                </span>
            </div>
        </div>
    </div>

    <div class="form-group mb-3">
        <label class="small font-weight-bold text-secondary mb-1">Mật khẩu:</label>
        <div class="input-group">
            <input type="password" class="form-control form-control-login" name="Password" autocomplete="current-password" placeholder="Nhập mật khẩu..." required maxlength="@AbpUserBase.MaxPlainPasswordLength">
            <div class="input-group-append">
                <span class="input-group-text input-group-text-login">
                    <i class="fas fa-lock"></i>
                </span>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="custom-control custom-checkbox">
            <input type="checkbox" class="custom-control-input" id="RememberMe" name="RememberMe" value="true" checked>
            <label class="custom-control-label small text-secondary" for="RememberMe">
                Ghi nhớ đăng nhập
            </label>
        </div>
    </div>

    <button type="submit" id="LoginButton" class="btn btn-login-submit btn-block">
        Đăng Nhập Quản Trị <i class="fas fa-sign-in-alt ml-2"></i>
    </button>
</form>

<div class="mt-4 pt-3 border-top">
    <div class="text-center small text-muted mb-2 font-weight-bold">Lối tắt truy cập nhanh:</div>
    <a href="/Exams" class="quick-guest-btn mb-2">
        <i class="fas fa-tasks mr-2 text-primary"></i>Vào trang Quản lý Đề thi TOEIC
    </a>
    <a href="http://localhost:8080" target="_blank" class="quick-guest-btn">
        <i class="fas fa-laptop mr-2 text-success"></i>Mở giao diện Làm bài thi (Flutter Web)
    </a>
</div>
