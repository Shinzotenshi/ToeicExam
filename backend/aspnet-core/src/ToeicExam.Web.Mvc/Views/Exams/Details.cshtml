@using ToeicExam.Toeic.Dto
@model ExamDetailDto
@{
    ViewBag.Title = "Xem trước đề thi - " + Model.Title;
    var part5Groups = Model.QuestionGroups.Where(g => g.PartNumber == 5).ToList();
    var part6Groups = Model.QuestionGroups.Where(g => g.PartNumber == 6).ToList();
    var part7Groups = Model.QuestionGroups.Where(g => g.PartNumber == 7).ToList();
}

<style>
    .passage-card {
        background: #fdfdfd;
        border-left: 5px solid #007bff;
        white-space: pre-line;
        font-size: 15px;
        line-height: 1.6;
    }
    .question-block {
        border-bottom: 1px dashed #dee2e6;
        padding-bottom: 16px;
        margin-bottom: 16px;
    }
    .correct-badge {
        background: #28a745;
        color: white;
        font-weight: bold;
        padding: 3px 8px;
        border-radius: 4px;
    }
    .option-item {
        padding: 6px 12px;
        border-radius: 6px;
        margin-bottom: 4px;
        background: #f8f9fa;
        border: 1px solid #e9ecef;
    }
    .option-item.is-key {
        background: #e8f5e9;
        border-color: #a5d6a7;
        font-weight: 600;
        color: #1b5e20;
    }
</style>

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-8">
                <h1 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-file-alt mr-2"></i>@Model.Title
                </h1>
                <p class="text-muted mb-0 mt-1">
                    <span class="badge badge-primary mr-2"><i class="fas fa-clock mr-1"></i>@Model.DurationMinutes phút</span>
                    <span class="badge badge-success mr-2"><i class="fas fa-list-ol mr-1"></i>@Model.TotalQuestions câu hỏi</span>
                    <span class="badge badge-info"><i class="fas fa-calendar-alt mr-1"></i>Tạo lúc @Model.CreationTime.ToString("dd/MM/yyyy HH:mm")</span>
                </p>
            </div>
            <div class="col-sm-4 text-right">
                <a href="@Url.Action("Edit", "Exams", new { id = Model.Id })" class="btn btn-warning shadow-sm mr-2">
                    <i class="fas fa-edit mr-1"></i> Chỉnh sửa đề thi
                </a>
                <a href="@Url.Action("Index", "Exams")" class="btn btn-secondary shadow-sm">
                    <i class="fas fa-arrow-left mr-1"></i> Quay lại
                </a>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <!-- Navigation Pills for Parts -->
        <ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
            <li class="nav-item">
                <a class="nav-link active font-weight-bold" id="pills-part5-tab" data-toggle="pill" href="#pills-part5" role="tab">
                    <i class="fas fa-tasks mr-1"></i> Part 5: Câu hỏi độc lập (@part5Groups.Sum(g => g.Questions.Count) câu)
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link font-weight-bold" id="pills-part6-tab" data-toggle="pill" href="#pills-part6" role="tab">
                    <i class="fas fa-file-invoice mr-1"></i> Part 6: Điền từ vào đoạn văn (@part6Groups.Sum(g => g.Questions.Count) câu)
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link font-weight-bold" id="pills-part7-tab" data-toggle="pill" href="#pills-part7" role="tab">
                    <i class="fas fa-book-open mr-1"></i> Part 7: Đọc hiểu văn bản (@part7Groups.Sum(g => g.Questions.Count) câu)
                </a>
            </li>
        </ul>

        <div class="tab-content" id="pills-tabContent">
            <!-- PART 5 -->
            <div class="tab-pane fade show active" id="pills-part5" role="tabpanel">
                <div class="card card-outline card-primary shadow-sm">
                    <div class="card-header bg-white">
                        <h4 class="card-title font-weight-bold text-dark m-0">Part 5: Incomplete Sentences (Câu 101 - 130)</h4>
                    </div>
                    <div class="card-body">
                        @foreach (var group in part5Groups)
                        {
                            @foreach (var q in group.Questions)
                            {
                                <div class="question-block" id="q-@q.Id">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h5 class="font-weight-bold text-dark m-0">
                                            <span class="badge badge-dark mr-2">Câu @q.QuestionNumber</span>
                                            @q.Content
                                        </h5>
                                        <span class="correct-badge"><i class="fas fa-check mr-1"></i>Đáp án: @q.CorrectOption</span>
                                    </div>
                                    <div class="row mt-2">
                                        @foreach (var opt in q.Options)
                                        {
                                            var isKey = string.Equals(opt.OptionKey, q.CorrectOption, StringComparison.OrdinalIgnoreCase);
                                            <div class="col-md-6 mb-2">
                                                <div class="option-item @(isKey ? "is-key" : "")">
                                                    <strong>(@opt.OptionKey)</strong> @opt.Content
                                                    @if (isKey)
                                                    {
                                                        <span class="badge badge-success float-right"><i class="fas fa-check"></i> ĐÚNG</span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- PART 6 -->
            <div class="tab-pane fade" id="pills-part6" role="tabpanel">
                @foreach (var group in part6Groups)
                {
                    <div class="card card-outline card-info shadow-sm mb-4">
                        <div class="card-header bg-white">
                            <h4 class="card-title font-weight-bold text-dark m-0">
                                <i class="fas fa-newspaper mr-2 text-info"></i>@group.Title
                            </h4>
                        </div>
                        <div class="card-body">
                            @if (!string.IsNullOrEmpty(group.PassageText))
                            {
                                <div class="passage-card p-3 rounded mb-4 shadow-sm border">
                                    @Html.Raw(Html.Encode(group.PassageText).Replace("\n", "<br/>"))
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(group.PassageImageUrl))
                            {
                                <div class="text-center mb-4">
                                    <img src="@group.PassageImageUrl" alt="Hình ảnh đoạn văn" class="img-fluid rounded border shadow-sm" style="max-height: 350px;" />
                                </div>
                            }
                            <div class="questions-list">
                                @foreach (var q in group.Questions)
                                {
                                    <div class="question-block" id="q-@q.Id">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h6 class="font-weight-bold text-dark m-0">
                                                <span class="badge badge-info mr-2">Câu @q.QuestionNumber</span>
                                                @q.Content
                                            </h6>
                                            <span class="correct-badge"><i class="fas fa-check mr-1"></i>Đáp án: @q.CorrectOption</span>
                                        </div>
                                        <div class="row mt-2">
                                            @foreach (var opt in q.Options)
                                            {
                                                var isKey = string.Equals(opt.OptionKey, q.CorrectOption, StringComparison.OrdinalIgnoreCase);
                                                <div class="col-md-6 mb-2">
                                                    <div class="option-item @(isKey ? "is-key" : "")">
                                                        <strong>(@opt.OptionKey)</strong> @opt.Content
                                                        @if (isKey)
                                                        {
                                                            <span class="badge badge-success float-right"><i class="fas fa-check"></i> ĐÚNG</span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- PART 7 -->
            <div class="tab-pane fade" id="pills-part7" role="tabpanel">
                @foreach (var group in part7Groups)
                {
                    <div class="card card-outline card-success shadow-sm mb-4">
                        <div class="card-header bg-white">
                            <h4 class="card-title font-weight-bold text-dark m-0">
                                <i class="fas fa-book-reader mr-2 text-success"></i>@group.Title
                            </h4>
                        </div>
                        <div class="card-body">
                            @if (!string.IsNullOrEmpty(group.PassageText))
                            {
                                <div class="passage-card p-3 rounded mb-4 shadow-sm border" style="border-left-color: #28a745;">
                                    @Html.Raw(Html.Encode(group.PassageText).Replace("\n", "<br/>"))
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(group.PassageImageUrl))
                            {
                                <div class="text-center mb-4">
                                    <img src="@group.PassageImageUrl" alt="Hình ảnh đoạn văn" class="img-fluid rounded border shadow-sm" style="max-height: 400px;" />
                                </div>
                            }
                            <div class="questions-list">
                                @foreach (var q in group.Questions)
                                {
                                    <div class="question-block" id="q-@q.Id">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h6 class="font-weight-bold text-dark m-0">
                                                <span class="badge badge-success mr-2">Câu @q.QuestionNumber</span>
                                                @q.Content
                                            </h6>
                                            <span class="correct-badge"><i class="fas fa-check mr-1"></i>Đáp án: @q.CorrectOption</span>
                                        </div>
                                        <div class="row mt-2">
                                            @foreach (var opt in q.Options)
                                            {
                                                var isKey = string.Equals(opt.OptionKey, q.CorrectOption, StringComparison.OrdinalIgnoreCase);
                                                <div class="col-md-6 mb-2">
                                                    <div class="option-item @(isKey ? "is-key" : "")">
                                                        <strong>(@opt.OptionKey)</strong> @opt.Content
                                                        @if (isKey)
                                                        {
                                                            <span class="badge badge-success float-right"><i class="fas fa-check"></i> ĐÚNG</span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
