@using ToeicExam.Toeic.Dto
@model ExamDetailDto
@{
    ViewBag.Title = "Chỉnh sửa nội dung đề thi - " + Model.Title;
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-8">
                <h1 class="m-0 font-weight-bold text-warning">
                    <i class="fas fa-edit mr-2"></i>Chỉnh sửa nội dung đề thi: @Model.Title
                </h1>
                <p class="text-muted mb-0 mt-1">Rà soát lỗi chính tả, nội dung câu hỏi, đoạn văn và đáp án</p>
            </div>
            <div class="col-sm-4 text-right">
                <a href="@Url.Action("Details", "Exams", new { id = Model.Id })" class="btn btn-info shadow-sm mr-2">
                    <i class="fas fa-eye mr-1"></i> Xem trước
                </a>
                <a href="@Url.Action("Index", "Exams")" class="btn btn-secondary shadow-sm">
                    <i class="fas fa-arrow-left mr-1"></i> Danh sách đề
                </a>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div id="alertBox"></div>

        @foreach (var group in Model.QuestionGroups)
        {
            <div class="card card-outline @(group.PartNumber == 5 ? "card-primary" : group.PartNumber == 6 ? "card-info" : "card-success") shadow-sm mb-4">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="card-title font-weight-bold m-0 text-dark">
                        <span class="badge @(group.PartNumber == 5 ? "badge-primary" : group.PartNumber == 6 ? "badge-info" : "badge-success") mr-2">Part @group.PartNumber</span>
                        @group.Title
                    </h5>
                    @if (group.PartNumber != 5)
                    {
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="saveGroup(@group.Id)">
                            <i class="fas fa-save mr-1"></i> Lưu đoạn văn
                        </button>
                    }
                </div>
                <div class="card-body">
                    @if (group.PartNumber != 5)
                    {
                        <div class="form-group mb-4">
                            <label class="font-weight-bold text-dark"><i class="fas fa-paragraph mr-1"></i>Nội dung đoạn văn (Passage):</label>
                            <textarea id="group-passage-@group.Id" class="form-control" rows="6" style="font-family: inherit; font-size: 14px;">@group.PassageText</textarea>
                        </div>
                    }

                    <div class="questions-container">
                        @foreach (var q in group.Questions)
                        {
                            <div class="border rounded p-3 mb-3 bg-light" id="q-card-@q.Id">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="font-weight-bold text-dark m-0">
                                        <span class="badge badge-secondary mr-2">Câu @q.QuestionNumber</span>
                                    </h6>
                                    <div class="d-flex align-items-center">
                                        <label class="font-weight-bold text-success mr-2 mb-0">Đáp án đúng:</label>
                                        <select id="q-key-@q.Id" class="form-control form-control-sm mr-2" style="width: 70px; display: inline-block;">
                                            <!option value="A" @(q.CorrectOption == "A" ? "selected" : "")>A</!option>
                                            <!option value="B" @(q.CorrectOption == "B" ? "selected" : "")>B</!option>
                                            <!option value="C" @(q.CorrectOption == "C" ? "selected" : "")>C</!option>
                                            <!option value="D" @(q.CorrectOption == "D" ? "selected" : "")>D</!option>
                                        </select>
                                        <button type="button" class="btn btn-sm btn-success" onclick="saveQuestion(@q.Id)">
                                            <i class="fas fa-save mr-1"></i> Lưu câu @q.QuestionNumber
                                        </button>
                                    </div>
                                </div>

                                <div class="form-group mb-2">
                                    <label class="small text-muted mb-1">Nội dung câu hỏi:</label>
                                    <input type="text" id="q-content-@q.Id" class="form-control" value="@q.Content" />
                                </div>

                                <div class="row">
                                    @foreach (var opt in q.Options)
                                    {
                                        <div class="col-md-6 mb-2">
                                            <div class="input-group input-group-sm">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text font-weight-bold">@opt.OptionKey</span>
                                                </div>
                                                <input type="text" class="form-control" id="opt-content-@opt.Id" data-opt-id="@opt.Id" data-opt-key="@opt.OptionKey" value="@opt.Content" />
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<script>
    function showAlert(msg, isSuccess) {
        var box = document.getElementById('alertBox');
        var alertClass = isSuccess ? 'alert-success' : 'alert-danger';
        var icon = isSuccess ? 'fa-check-circle' : 'fa-exclamation-circle';
        box.innerHTML = `
            <div class="alert ${alertClass} alert-dismissible fade show shadow-sm" role="alert">
                <i class="fas ${icon} mr-2"></i> ${msg}
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        `;
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function saveGroup(groupId) {
        var text = document.getElementById('group-passage-@Model.Id' ? 'group-passage-' + groupId : 'group-passage-' + groupId).value;
        fetch('/Exams/UpdateGroup', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: groupId, passageText: text })
        })
        .then(r => r.json())
        .then(res => {
            if (res.success) {
                showAlert(res.message, true);
            } else {
                showAlert(res.message, false);
            }
        })
        .catch(e => showAlert('Lỗi mạng: ' + e, false));
    }

    function saveQuestion(qId) {
        var content = document.getElementById('q-content-' + qId).value;
        var key = document.getElementById('q-key-' + qId).value;

        var qCard = document.getElementById('q-card-' + qId);
        var optInputs = qCard.querySelectorAll('[data-opt-id]');
        var options = [];
        optInputs.forEach(inp => {
            options.push({
                id: parseInt(inp.getAttribute('data-opt-id')),
                optionKey: inp.getAttribute('data-opt-key'),
                content: inp.value
            });
        });

        fetch('/Exams/UpdateQuestion', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                id: qId,
                content: content,
                correctOption: key,
                options: options
            })
        })
        .then(r => r.json())
        .then(res => {
            if (res.success) {
                showAlert(res.message, true);
            } else {
                showAlert(res.message, false);
            }
        })
        .catch(e => showAlert('Lỗi mạng: ' + e, false));
    }
</script>
